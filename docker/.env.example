# Variabel untuk docker-compose.yml. Tambahkan ke file .env di ROOT repo di server
# (docker compose otomatis membacanya; file yang sama berisi DB_* / STAGING_DB_* yang dirujuk apps/api/.env).

# Alamat publik aplikasi (dipakai untuk CORS API)
PUBLIC_URL=https://sinobisnis.contoh.com
# 1 = cookie login hanya lewat HTTPS (production). 0 = uji coba lewat http://IP-server:3001
COOKIE_SECURE=1
# 127.0.0.1 = hanya lewat reverse proxy (Nginx/Caddy) di server. 0.0.0.0 = dibuka langsung di jaringan.
WEB_BIND=127.0.0.1
WEB_PORT=3001
