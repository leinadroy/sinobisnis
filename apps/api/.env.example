# MariaDB lokal dengan struktur production (database sinobisnis). Salin ke .env lalu isi; .env tidak di-commit.
# Password di-URL-encode bila berisi karakter khusus.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sinobisnis"

# Secret untuk menandatangani JWT login (isi string acak panjang).
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="12h"

# SystemSalt GeneXus untuk memverifikasi password lama (nilai asli hanya di .env lokal).
SYSTEM_SALT=""

# Port API & origin web yang diizinkan (CORS)
PORT=4000
WEB_ORIGIN="http://localhost:3001"

# Penjadwal reminder email berjalan di dalam API (diatur dari System Configurator).
# Isi off pada instance tambahan bila API dijalankan lebih dari satu supaya email tidak terkirim ganda.
# REMINDER_SCHEDULER=off

# Profil database (Developer Menu → Database, hanya role Developer). Tanpa DB_PROFILES dipakai DATABASE_URL saja.
# Nilai boleh memakai ${DATABASE_URL}; DB_DATABASE_<PROFIL> mengganti nama database. Prisma CLI & script tetap memakai DATABASE_URL.
# DB_PROFILES=local,staging,production
# DB_LABEL_LOCAL="Lokal laptop"
# DB_URL_LOCAL=${DATABASE_URL}
# DB_URL_STAGING=${DATABASE_URL}
# DB_DATABASE_STAGING=sinobisnis_test
# DB_URL_PRODUCTION=     # isi saat go-live, dengan user database khusus (bukan gxmysql)
# DB_MENU_SYNC_PRODUCTION=0   # default production 0: menuitem 38–42 tidak ditambahkan otomatis
# DB_WRITE_USERS_PRODUCTION=1 # pengecualian hanya-baca: tabel users boleh ditulis (login/user dari production sendiri)
# DB_PROFILE_DEFAULT=local
# DB_PROFILE_FILE=config/db-profile.json
