# MariaDB lokal dengan struktur production (database sinobisnis). Salin ke .env lalu isi; .env tidak di-commit.
# Password di-URL-encode bila berisi karakter khusus.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sinobisnis"

# Secret untuk menandatangani JWT login (isi string acak panjang).
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="12h"

# Port API & origin web yang diizinkan (CORS)
PORT=4000
WEB_ORIGIN="http://localhost:3001"

# Penjadwal reminder email berjalan di dalam API (diatur dari System Configurator).
# Isi off pada instance tambahan bila API dijalankan lebih dari satu supaya email tidak terkirim ganda.
# REMINDER_SCHEDULER=off
