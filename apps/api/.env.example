# PostgreSQL lokal (aplikasi baru). Salin ke .env lalu isi; .env tidak di-commit.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sinobisnis_app?schema=public"

# Secret untuk menandatangani JWT login (isi string acak panjang).
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="12h"

# Port API & origin web yang diizinkan (CORS)
PORT=4000
WEB_ORIGIN="http://localhost:3001"

# Akun admin awal yang dibuat oleh `npm run db:seed` (hanya bila belum ada user)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Folder penyimpanan lampiran (default: apps/api/storage/uploads)
# UPLOAD_DIR="D:/sinobisnis/uploads"
