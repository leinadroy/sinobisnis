<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site IIS untuk uji coba TANPA HTTPS (mis. http://10.10.3.61): semua request diteruskan ke Next.js di 127.0.0.1:3001.
  Pasangan dari ..\iis\web.config (yang memaksa HTTPS). Web harus jalan dengan COOKIE_SECURE=0
  (install-services.ps1 mengaturnya otomatis bila -Domain diawali http://).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Sinobisnis Web" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Upload lampiran: maks. 20 file x 20 MB per kirim -->
        <requestLimits maxAllowedContentLength="419430400" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
